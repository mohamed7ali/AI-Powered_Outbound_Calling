# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- LLM (OpenAI)
OPENAI_API_KEY=
# Model used for the latency-critical in-call turns
OPENAI_CALL_MODEL=gpt-4o-mini
# Model used for reporting, reranking and grounding checks
OPENAI_REASONING_MODEL=gpt-4o
# Embeddings for the KB chunks (3072 dims; must match the pgvector column)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=3072

# ------------------------------------------------------------------- STT (Whisper)
# whisper-1 | gpt-4o-transcribe | gpt-4o-mini-transcribe
STT_MODEL=gpt-4o-transcribe
STT_LANGUAGE=ar

# -------------------------------------------------------------- TTS (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# In-call turns: lowest latency. Static/cached prompts use the quality model below.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_QUALITY_MODEL_ID=eleven_multilingual_v2
# Streaming into Gradio needs raw PCM tuples, not MP3. MP3 is only for the disk cache.
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
# Static prompts are cached to disk as 16 kHz WAV (no ffmpeg/codec dependency)
AUDIO_CACHE_DIR=audio_cache

# ---------------------------------------------------------- Supabase / Postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set this for legacy HS256 projects; leave blank to use Supabase JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Direct Postgres connection used for pgvector queries and tenant-scoped repositories
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
# User-facing transactions must execute as authenticated so RLS remains active.
DB_RLS_ROLE=authenticated
DOCUMENT_STORAGE_BUCKET=organization-documents

# ------------------------------------------------------------------- Telephony
# simulated | vonage
TELEPHONY_PROVIDER=simulated
# Vonage Voice API: create an Application with Voice capability and keep private.key private.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=private.key
VONAGE_PUBLIC_KEY_PATH=public.key
VONAGE_FROM_NUMBER=
VONAGE_VERIFY_WEBHOOKS=true
PUBLIC_WEBHOOK_BASE_URL=https://YOUR-PUBLIC-8000-HOST.app.github.dev
# Public application URL used by Supabase invitation emails, e.g. https://your-domain/auth/invite
AUTH_REDIRECT_URL=
# Public Gradio URL used for presentation/deployment metadata
UI_PUBLIC_URL=

# ------------------------------------------------------------------------- App
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
GRADIO_PORT=7860
API_BASE_URL=http://localhost:8000
GRADIO_SERVER_NAME=0.0.0.0
SCHEDULER_INTERVAL_SECONDS=30
SCHEDULER_BATCH_SIZE=20

# ----------------------------------------------------------------- RAG tuning
# openai for production; deterministic is offline/test-only.
RAG_EMBEDDING_PROVIDER=openai
RAG_TOP_K_DENSE=20
RAG_TOP_K_SPARSE=20
RAG_RRF_K=60
RAG_TOP_N_AFTER_RERANK=5
RAG_MIN_GROUNDING_SCORE=0.7
# Optional backward-compatible server-to-server seam; bearer JWT is preferred.
AGENT_INTERNAL_TOKEN=
