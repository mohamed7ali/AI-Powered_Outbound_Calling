# Arabic AI-Powered Outbound Calls environment template
# Copy this file to .env and fill only the values required by your deployment.

# ---------------------------------------------------------------- LLM providers
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional OpenAI-compatible fallback/provider.
OPENAI_API_KEY=
OPENAI_CALL_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o

# ----------------------------------------------------------------- RAG embeddings
# Default local Arabic Sentence Transformer; downloaded on first use.
RAG_EMBEDDING_PROVIDER=sentence_transformers
RAG_EMBEDDING_DIM=384
SENTENCE_TRANSFORMER_MODEL=Omartificial-Intelligence-Space/Arabic-MiniLM-L12-v2-all-nli-triplet
SENTENCE_TRANSFORMER_DEVICE=cpu
# Optional OpenAI-compatible alternative; dimension must match RAG_EMBEDDING_DIM.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=384

# ------------------------------------------------------- Optional local voice
# Disabled by default. Install with: pip install -e '.[local-voice]'
LOCAL_STT_ENABLED=false
LOCAL_STT_MODEL=small
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE_TYPE=int8
LOCAL_TTS_ENABLED=false
LOCAL_TTS_MODEL=facebook/mms-tts-ara
LOCAL_VOICE_AUDIO_DIR=.cache/voice-audio
# Required only if generated local WAV files are streamed into Vonage.
LOCAL_VOICE_PUBLIC_BASE_URL=

# ---------------------------------------------------------- Supabase / Postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Leave blank for current Supabase JWKS verification unless using legacy HS256.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
# User-facing transactions must execute as authenticated so PostgreSQL RLS remains active.
DB_RLS_ROLE=authenticated
DOCUMENT_STORAGE_BUCKET=organization-documents

# ------------------------------------------------------------------- Telephony
# simulated | vonage
TELEPHONY_PROVIDER=simulated
# Vonage Voice Application credentials.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=private.key
VONAGE_PUBLIC_KEY_PATH=public.key
VONAGE_FROM_NUMBER=
# Account API signature secret for signed inbound callbacks; separate from private.key.
VONAGE_SIGNATURE_SECRET=
VONAGE_VERIFY_WEBHOOKS=true
# Public HTTPS host for the API callbacks, not the Gradio host and not localhost.
PUBLIC_WEBHOOK_BASE_URL=https://YOUR-PUBLIC-8000-HOST.app.github.dev

# ------------------------------------------------------------------------- App
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
GRADIO_PORT=7860
API_BASE_URL=http://localhost:8000
GRADIO_SERVER_NAME=0.0.0.0
# Public URL used by Supabase invitation emails.
AUTH_REDIRECT_URL=
# Public Gradio URL used for deployment metadata.
UI_PUBLIC_URL=
SCHEDULER_INTERVAL_SECONDS=30
SCHEDULER_BATCH_SIZE=20

# ----------------------------------------------------------------- RAG tuning
RAG_TOP_K_DENSE=20
RAG_TOP_K_SPARSE=20
RAG_RRF_K=60
RAG_TOP_N_AFTER_RERANK=5
# These are ranking thresholds, not probabilities.
RAG_MIN_CITATION_SCORE=0.30
RAG_CITATION_RELATIVE_THRESHOLD=0.75
RAG_MAX_CITATIONS=3
RAG_MIN_GROUNDING_SCORE=0.7
# Optional server-to-server seam; bearer JWT is preferred.
AGENT_INTERNAL_TOKEN=
